{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Deploy to iPhone",
            "type": "shell",
            "command": "./deploy.sh",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$swiftc"]
        },
        {
            "label": "Build only",
            "type": "shell",
            "command": "xtool dev build",
            "group": "build",
            "problemMatcher": ["$swiftc"]
        }
    ]
}
